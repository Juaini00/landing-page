---
// src/layouts/Layout.astro
interface Props {
  title?: string;
}
const { title = 'Juaini — Software Engineer' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <meta name="description" content="Juaini — Software Engineer specializing in backend systems, mobile apps, and web frontends. Spring Boot, Node.js, React Native, Kotlin Multiplatform. Available for freelance and full-time roles." />
    <meta name="author" content="Juaini" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://portfolio-juaini.vercel.app" />
    <meta property="og:title" content="Juaini — Software Engineer" />
    <meta property="og:description" content="Backend systems, mobile apps, and web frontends. Spring Boot · Node.js · React Native · Kotlin Multiplatform. Available for freelance and full-time roles." />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Juaini — Software Engineer" />
    <meta name="twitter:description" content="Backend systems, mobile apps, and web frontends. Spring Boot · Node.js · React Native · Kotlin Multiplatform." />

    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500;600&family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
