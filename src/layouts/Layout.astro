---
// src/layouts/Layout.astro
interface Props {
  title?: string;
}

const { title = 'Juaini — Software Engineer | Backend, Mobile & Applied AI' } = Astro.props;
const description = 'Software Engineer building production backend systems, cross-platform mobile apps, modern web products, and reliable AI-assisted workflows.';
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Juaini',
  url: 'https://portfolio-juaini.vercel.app',
  jobTitle: 'Software Engineer',
  sameAs: [
    'https://www.linkedin.com/in/juaini-i',
    'https://github.com/Juaini00',
  ],
  knowsAbout: [
    'Backend Engineering',
    'Applied AI',
    'LLM Applications',
    'AI Guardrails',
    'Vector Retrieval',
    'Spring Boot',
    'Rust',
    'PostgreSQL',
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <meta name="description" content={description} />
    <meta name="author" content="Juaini" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://portfolio-juaini.vercel.app" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500;600&family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
