---
// src/components/Stack.astro
const cells = [
  {
    key: 'languages', label: 'Languages', desc: '// daily drivers', count: '7', countLabel: 'langs',
    svgPath: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>',
    primary: ['Java', 'TypeScript', 'PHP'],
    items: ['JavaScript', 'Go', 'Rust', 'Kotlin'],
  },
  {
    key: 'backend', label: 'Backend', desc: '// where I live', count: '9', countLabel: 'frameworks',
    svgPath: '<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14a9 3 0 0 0 18 0V5"/><path d="M3 12a9 3 0 0 0 18 0"/>',
    primary: ['Spring Boot', 'NestJS', 'Laravel'],
    items: ['Jersey', 'Express', 'Axum', 'Gin', 'Maven', 'Gradle'],
  },
  {
    key: 'frontend', label: 'Frontend', desc: '// full-stack capable', count: '5', countLabel: 'libs',
    svgPath: '<rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>',
    primary: ['React', 'Next.js'],
    items: ['Vue', 'Angular', 'Tailwind', 'Figma'],
  },
  {
    key: 'mobile', label: 'Mobile', desc: '// cross-platform', count: '2', countLabel: 'platforms',
    svgPath: '<rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/>',
    primary: ['React Native', 'Kotlin Multiplatform'],
    items: [],
  },
  {
    key: 'data', label: 'Data', desc: '// SQL + KV + ORM', count: '7', countLabel: 'stores',
    svgPath: '<ellipse cx="12" cy="6" rx="8" ry="3"/><path d="M4 6v6c0 1.66 3.58 3 8 3s8-1.34 8-3V6"/><path d="M4 12v6c0 1.66 3.58 3 8 3s8-1.34 8-3v-6"/>',
    primary: ['PostgreSQL', 'Redis'],
    items: ['MySQL', 'MongoDB', 'Hibernate / JPA', 'TypeORM', 'Prisma'],
  },
  {
    key: 'cloud', label: 'Cloud & Infra', desc: '// event-driven', count: '5', countLabel: 'services',
    svgPath: '<path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/>',
    primary: ['AWS Lambda', 'Docker'],
    items: ['GitHub Actions', 'Grafana', 'CloudPanel'],
  },
  {
    key: 'testing', label: 'Testing', desc: '// unit → e2e', count: '6', countLabel: 'tools',
    svgPath: '<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>',
    primary: ['JUnit', 'Mockito'],
    items: ['Jest', 'Playwright', 'Swagger', 'Postman'],
  },
  {
    key: 'practices', label: 'Practices', desc: '// how I ship', count: '7', countLabel: 'habits',
    svgPath: '<path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>',
    primary: ['Clean Architecture', 'TDD'],
    items: ['Agile / Scrum', 'Code Review', 'Jira', 'Confluence', 'Notion'],
  },
];
---
<section class="py-[120px] border-b border-border" id="stack">
  <div class="wrap">

    <div class="sec-head">
      <div class="sec-num">02</div>
      <div class="sec-head-mid">
        <div class="sec-kicker">
          <span class="bar"></span>
          <span data-i18n="stack.kicker.label">Toolbox</span>
          <span class="meta">// 32+ tools</span>
        </div>
        <h2 class="sec-title" data-i18n="stack.title">The stack I reach for<br/>on <em>day one.</em></h2>
      </div>
      <div class="sec-side">
        <div class="sec-stat">8 categories · <b>backend-first</b></div>
        <p class="sec-desc" data-i18n="stack.desc">Backend is my home base — distributed systems, APIs, and microservices. Full-stack capable when the project calls for it.</p>
      </div>
    </div>
    <div class="sec-rule"></div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-px bg-border border border-border rounded-[14px] overflow-hidden">
      {cells.map(({ key, label, desc, count, countLabel, svgPath, primary, items }) => (
        <div class="stack-cell">
          <div class="stack-cell-head">
            <div class="ico">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={svgPath} />
            </div>
            <span class="count"><b>{count}</b> {countLabel}</span>
          </div>
          <h4 data-i18n={`stack.${key}`}>{label}</h4>
          <div class="cell-desc">{desc}</div>
          <div class="items">
            {primary.map((item) => (
              <span class="chip primary">{item}</span>
            ))}
            {items.map((item) => (
              <span class="chip">{item}</span>
            ))}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
