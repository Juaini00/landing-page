---
// Applied AI window: chrome headline, big "25" corner notch, six-step runtime
// pipeline with the glowing green policy gate, four principle cards, and the
// principle dock.
import type { CmsContent } from '../lib/cms';
import { chrome, aiFlowIcons, aiPrincipleIcons } from '../lib/chrome';
import Ico from './Ico.astro';
import Window from './Window.astro';

interface Props {
  content: CmsContent;
}
const { content } = Astro.props;
const en = content.translations.en;

const flow = [
  { key: 'ai.flow.input', icon: aiFlowIcons[0] },
  { key: 'ai.flow.retrieve', icon: aiFlowIcons[1] },
  { key: 'ai.flow.plan', icon: aiFlowIcons[2] },
  { key: 'ai.flow.guard', icon: aiFlowIcons[3], guard: true },
  { key: 'ai.flow.execute', icon: aiFlowIcons[4] },
  { key: 'ai.flow.output', icon: aiFlowIcons[5] },
];
const principles = ['grounded', 'constrained', 'deterministic', 'observable'].map(k => ({
  k,
  icon: aiPrincipleIcons[k],
}));
---
<Window id="ai" tabKey="ext.ai.tab" tabEn={chrome.en['ext.ai.tab']} variant="ai" bp="60% 80%">
  <div class="notch-count dock notch-top">
    <span class="fillet f-tl fa"></span>
    <b class="chrome" data-i18n="stats.cert.num" set:html={en['stats.cert.num']} />
    <span data-i18n="stats.cert.label" set:html={en['stats.cert.label']} />
  </div>
  <div class="pad">
  <div class="ai-head">
    <h2 class="chrome display" data-i18n="ai.title" set:html={en['ai.title']} />
    <p class="desc" data-i18n="ai.desc" set:html={en['ai.desc']} />
  </div>
  <div class="ai-grid">
    <div class="glass workflow">
      <div class="whead">
        <div class="lbl">{content.projects[0] && <span data-i18n={`${content.projects[0].i18nPrefix}.title`} set:html={en[`${content.projects[0].i18nPrefix}.title`]} />} · <span data-i18n="ext.ai.workflow">{chrome.en['ext.ai.workflow']}</span></div>
        <div class="pill-green"><span class="dot"></span><span data-i18n="ext.ai.failclosed">{chrome.en['ext.ai.failclosed']}</span></div>
      </div>
      <div class="pipeline" data-trace>
        {
          flow.map((s, i) => (
            <div class={`pstep${s.guard ? ' guard' : ''}`} data-pipeline-step>
              {i < flow.length - 1 && <span class="pipeline-link" aria-hidden="true"><span data-pipeline-line /></span>}
              <div class="ic"><Ico name={s.icon} /><span class="pipeline-emphasis" aria-hidden="true" /></div>
              <b data-i18n={s.key} set:html={en[s.key]} />
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
            </div>
          ))
        }
      </div>
    </div>
    <div class="principles">
      {
        principles.map((p) => (
          <div class="glass principle" data-reveal>
            <div class="ic"><Ico name={p.icon} /></div>
            <h4 data-i18n={`ai.${p.k}.title`} set:html={en[`ai.${p.k}.title`]} />
            <p data-i18n={`ai.${p.k}.desc`} set:html={en[`ai.${p.k}.desc`]} />
          </div>
        ))
      }
    </div>
  </div>
  </div>
  <div class="dock-principle dock dock-br">
    <span class="fillet f-tl fa"></span><span class="fillet f-tl fb"></span>
    <div class="ic green"><Ico name="shield" /></div>
    <p data-i18n="ai.principle" set:html={en['ai.principle']} />
  </div>
</Window>
