---
import type { CmsContent } from '../lib/cms';
import { chrome } from '../lib/chrome';
import Ico from './Ico.astro';
interface Props { content: CmsContent; }
const { content } = Astro.props;
const en = content.translations.en;
const links = [
  { href: '#top', key: 'ext.nav.home', label: chrome.en['ext.nav.home'] },
  ...['work', 'ai', 'stack', 'projects', 'contact'].map(section => ({ href: `#${section}`, key: `nav.${section}`, label: en[`nav.${section}`] })),
];
---
<nav class="top" aria-label={chrome.en['ext.nav.primary']} data-i18n-aria-label="ext.nav.primary">
  <a class="wordmark" href="#top">{content.settings.name}<b>.</b></a>
  <div class="nav-capsule">
    <span class="burger" aria-hidden="true"><Ico name="menu" /></span>
    {links.map(link => <a href={link.href} aria-current={link.href === '#top' ? 'location' : undefined}><span data-i18n={link.key} set:html={link.label} /></a>)}
    <span class="nav-indicator" aria-hidden="true"></span>
    <span class="nav-dots" aria-hidden="true"><i></i><i></i><i></i></span>
  </div>
  <button class="lang" type="button" aria-label="Switch to Indonesian"><b>EN</b> / ID</button>
  <button class="menu-btn" type="button" aria-haspopup="dialog" aria-controls="mobile-menu" aria-expanded="false"><Ico name="menu" /><span data-i18n="ext.nav.menu">{chrome.en['ext.nav.menu']}</span></button>
</nav>
<nav class="mobile-nav-fallback" aria-label={chrome.en['ext.nav.primary']} data-i18n-aria-label="ext.nav.primary">
  {links.map(link => <a href={link.href} aria-current={link.href === '#top' ? 'location' : undefined}><span data-i18n={link.key} set:html={link.label} /></a>)}
</nav>
<dialog class="mobile-menu" id="mobile-menu" aria-label={chrome.en['ext.nav.siteMenu']} data-i18n-aria-label="ext.nav.siteMenu">
  <button class="close" type="button" autofocus aria-label={chrome.en['ext.nav.close']} data-i18n-aria-label="ext.nav.close">×</button>
  <div class="sheet">
    {links.map(link => <a href={link.href} aria-current={link.href === '#top' ? 'location' : undefined}><span data-i18n={link.key} set:html={link.label} /><Ico name="arrow-up-right" /></a>)}
  </div>
</dialog>
