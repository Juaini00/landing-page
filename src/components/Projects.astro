---
import type { CmsContent } from '../lib/cms';
import { chrome, factIcons, caseIcons } from '../lib/chrome';
import Chip from './Chip.astro';
import Ico from './Ico.astro';
import Window from './Window.astro';

interface Props {
  content: CmsContent;
  techIds: Map<string, string | null>;
}
const { content, techIds } = Astro.props;
const en = content.translations.en;
const builds = content.projects.slice(0, 2);
const cases = content.projects.slice(2);
const caseRange = cases.map(p => p.i18nPrefix.match(/(\d+)$/)?.[1]).filter(Boolean);
const range = caseRange.length > 1 ? `${caseRange[0]} — ${caseRange.at(-1)}` : (caseRange[0] ?? '');
const projTab = chrome.en['ext.proj.tab'].replace('{b}', String(builds.length)).replace('{c}', String(cases.length));
---
{builds.length === 0 && (
  <Window id="projects" tabKey="ext.proj.tab" tabEn={projTab} fmt={{ b: '0', c: '0' }} variant="project-window">
    <div class="pad">
      <div class="sec-head"><h2 class="chrome display" data-i18n="projects.title" set:html={en['projects.title']} /></div>
      <p data-i18n="ext.proj.empty">{chrome.en['ext.proj.empty']}</p>
    </div>
  </Window>
)}
{
  builds.map((p, i) => {
    const prefix = p.i18nPrefix;
    const titleKey = `${prefix}.title`;
    return (
      <Window
        id={i === 0 ? 'projects' : undefined}
        tabKey={i === 0 ? 'ext.proj.tab' : `${prefix}.num`}
        tabEn={i === 0 ? projTab : en[`${prefix}.num`]}
        fmt={i === 0 ? { b: String(builds.length), c: String(cases.length) } : undefined}
        variant="project-window"
        bp={i === 0 ? '30% 20%' : '80% 75%'}
      >
        <div class="pad">
          {i === 0 && (
            <div class="sec-head">
              <h2 class="chrome display" data-i18n="projects.title" set:html={en['projects.title']} />
              <div class="side"><p data-i18n="projects.desc" set:html={en['projects.desc']} /></div>
            </div>
          )}
          <div class={`build${p.layout === 'left' ? ' diagram-left' : ''}`}>
            <div class="bcopy" data-reveal="head">
              <div class="bnum" data-i18n={`${prefix}.num`}>{en[`${prefix}.num`]}</div>
              {p.statusI18nKey && (
                <div class="status-pill"><span class="dot"></span><span data-i18n={p.statusI18nKey}>{en[p.statusI18nKey]}</span></div>
              )}
              <h3 class="chrome" data-i18n={titleKey} set:html={en[titleKey]} />
              <p class="bdesc" data-i18n={`${prefix}.desc`} set:html={en[`${prefix}.desc`]} />
              {p.principleI18nKey && <p class="bprinciple" data-i18n={p.principleI18nKey} set:html={en[p.principleI18nKey]} />}
              {(p.factI18nKeys?.length ?? 0) > 0 && (
                <div class="facts">
                  {p.factI18nKeys?.map((key, n) => (
                    <div class="fact"><Ico name={factIcons[n % factIcons.length]} /><span data-i18n={key} set:html={en[key]} /></div>
                  ))}
                </div>
              )}
              {p.demoI18nKey && <div class="demo-note glass" data-i18n={p.demoI18nKey} set:html={en[p.demoI18nKey]} />}
              {(p.links?.length ?? 0) > 0 && (
                <div class="blinks">
                  {p.links?.map(link => (
                    <a class={link.tone === 'primary' ? 'go' : 'ln'} href={link.href} target="_blank" rel="noopener noreferrer">
                      <span data-i18n={link.labelI18n} set:html={en[link.labelI18n].replace(/\s*[↗→]\s*$/, '')} />
                      {link.tone === 'primary' && <span class="arr"><Ico name="arrow-up-right" /></span>}
                    </a>
                  ))}
                </div>
              )}
            </div>
            <div class="glass bdiag" data-reveal><div class="diagram" set:html={p.diagramHtml} /></div>
          </div>
          {p.media?.map(media => (
            <figure class="slot" data-reveal>
              <div class="media" data-media>
                {media.kind === 'video' ? (
                  <video src={media.url} poster={media.posterUrl} muted playsinline controls preload="none" aria-label={media.alt ?? en[titleKey]} />
                ) : (
                  <img src={media.url} alt={media.alt ?? en[titleKey]} loading="lazy" />
                )}
                <p data-media-error data-i18n="ext.motion.mediaError" hidden>{chrome.en['ext.motion.mediaError']}</p>
              </div>
            </figure>
          ))}
          <div class="bdock" data-reveal>
            <div class="bstats"><span data-i18n="projects.stat" set:html={en['projects.stat']} /></div>
            <div class="bmarks">
              {p.tech.map(name => {
                const id = techIds.get(name);
                return id ? <svg class="bmark" aria-label={name} role="img"><use href={`#${id}`} /></svg> : null;
              })}
              <span class="mono">{p.tech.join(' · ')}</span>
            </div>
          </div>
        </div>
      </Window>
    );
  })
}
{
  cases.length > 0 && (
    <Window tabKey="ext.proj.cases" tabEn={chrome.en['ext.proj.cases'].replace('{n}', range)} fmt={{ n: range }} variant="case-window" bp="50% 90%">
      <div class="pad">
        <div class="cases"><div class="cgrid">
          {cases.map((p, i) => (
            <article class="glass case" data-reveal>
              <div class="chead"><div class="ic"><Ico name={caseIcons[i % caseIcons.length]} /></div><div class="lbl" data-i18n={`${p.i18nPrefix}.num`}>{en[`${p.i18nPrefix}.num`]}</div></div>
              <h4 data-i18n={`${p.i18nPrefix}.title`} set:html={en[`${p.i18nPrefix}.title`]} />
              <p data-i18n={`${p.i18nPrefix}.desc`} set:html={en[`${p.i18nPrefix}.desc`]} />
              {p.statusI18nKey && <p data-i18n={p.statusI18nKey} set:html={en[p.statusI18nKey]} />}
              {p.principleI18nKey && <p data-i18n={p.principleI18nKey} set:html={en[p.principleI18nKey]} />}
              {p.factI18nKeys?.map(key => <p data-i18n={key} set:html={en[key]} />)}
              {p.demoI18nKey && <p data-i18n={p.demoI18nKey} set:html={en[p.demoI18nKey]} />}
              <div class="cchips">{p.tech.map((name, n) => <Chip name={name} symbolId={techIds.get(name) ?? null} primary={n === 0} />)}</div>
              <div class="diagram" set:html={p.diagramHtml} />
              {p.media?.map(media => (
                <figure class="slot"><div class="media" data-media>
                  {media.kind === 'video' ? <video src={media.url} poster={media.posterUrl} muted playsinline controls preload="none" aria-label={media.alt ?? en[`${p.i18nPrefix}.title`]} /> : <img src={media.url} alt={media.alt ?? en[`${p.i18nPrefix}.title`]} loading="lazy" />}
                  <p data-media-error data-i18n="ext.motion.mediaError" hidden>{chrome.en['ext.motion.mediaError']}</p>
                </div></figure>
              ))}
              {p.links?.map(link => <a class="ln" href={link.href} target="_blank" rel="noopener noreferrer"><span data-i18n={link.labelI18n} set:html={en[link.labelI18n].replace(/\s*[↗→]\s*$/, '')} /></a>)}
            </article>
          ))}
        </div></div>
      </div>
    </Window>
  )
}
