---
// Contact window: hero-mirror layout — chrome headline + CTA, profile notch,
// channels dock (email / LinkedIn / WhatsApp) and location dock.
import type { CmsContent } from '../lib/cms';
import { chrome } from '../lib/chrome';
import Ico from './Ico.astro';
import Window from './Window.astro';

interface Props {
  content: CmsContent;
}
const { content } = Astro.props;
const en = content.translations.en;
const s = content.settings;
const linkedinHandle = s.linkedinUrl.replace(/\/+$/, '').split('/').pop() ?? s.linkedinUrl;

const channels = [
  { icon: 'mail', labelKey: 'ext.contact.email', href: `mailto:${s.email}`, value: s.email },
  { icon: 'brand-linkedin', labelKey: 'ext.contact.linkedin', href: s.linkedinUrl, value: `@${linkedinHandle}` },
  { icon: 'brand-whatsapp', labelKey: 'ext.contact.whatsapp', href: `https://wa.me/${s.phone.replace(/[^0-9]/g, '')}`, value: s.phoneLabel },
];
---
<Window id="contact" tabKey="ext.contact.tab" tabEn={chrome.en['ext.contact.tab']} variant="contact" bp="70% 30%">
  <div class="copy" data-reveal="head">
    <div class="eyebrow">
      <span class="dot"></span><span data-i18n="contact.eyebrow" set:html={en['contact.eyebrow']} />
    </div>
    <h2 class="chrome display" data-i18n="contact.heading" set:html={en['contact.heading']} />
    <p class="sub" data-i18n="contact.sub" set:html={en['contact.sub']} />
    <div class="ctas">
      <a class="go" href={`mailto:${s.email}`}><span data-i18n="ext.contact.send">{chrome.en['ext.contact.send']}</span><span class="arr"><Ico name="arrow-up-right" /></span></a>
      <a class="ln" href={s.linkedinUrl} target="_blank" rel="noopener">
        <span data-i18n="ext.contact.linkedin">{chrome.en['ext.contact.linkedin']}</span>&nbsp;· @{linkedinHandle}
      </a>
    </div>
  </div>
  <div class="profile dock notch-r">
    <span class="fillet f-tl fa"></span><span class="fillet f-bl fb"></span>
    <div class="avatar"><img class="pic" src={s.avatarUrl} alt={s.avatarLabel} width="64" height="64" /></div>
    <div>
      <div class="lbl" data-i18n="ext.hero.engineer">{chrome.en['ext.hero.engineer']}</div>
      <div class="who">{s.name}</div>
      <div class="avail-line">
        <span data-i18n="contact.avail.status" set:html={en['contact.avail.status']} /> · <span data-i18n="contact.avail.remote" set:html={en['contact.avail.remote']} />
      </div>
    </div>
  </div>
  <div class="dock-channels dock dock-bl">
    <span class="fillet f-tr fa"></span><span class="fillet f-tr fb"></span>
    {
      channels.map((c) => (
        <a class="channel" href={c.href} target={c.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
          <div class="ic"><Ico name={c.icon} /></div>
          <div>
            <span class="lbl" data-i18n={c.labelKey}>{chrome.en[c.labelKey]}</span>
            <b>{c.value}</b>
          </div>
        </a>
      ))
    }
  </div>
  <div class="dock-where dock dock-br">
    <span class="fillet f-tl fa"></span><span class="fillet f-tl fb"></span>
    <div class="ic"><Ico name="map-pin" /></div>
    <div class="loc">
      <b data-i18n="contact.avail.from" set:html={en['contact.avail.from']} />
      <span data-i18n="contact.avail.remote" set:html={en['contact.avail.remote']} />
    </div>
    <div class="avail"><span class="dot"></span><span data-i18n="contact.avail.status" set:html={en['contact.avail.status']} /></div>
  </div>
</Window>
