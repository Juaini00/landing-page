---
import type { CmsContent } from '../lib/cms';
import { chrome, expRoleIcons } from '../lib/chrome';
import Ico from './Ico.astro';
import Window from './Window.astro';

interface Props {
  content: CmsContent;
}
const { content } = Astro.props;
const en = content.translations.en;

const roles = [
  {
    big: true,
    icon: expRoleIcons[0],
    labelKey: 'ext.role.current',
    date: 'exp.rivolta.date',
    dateExtra: 'exp.rivolta.present',
    roleKey: 'exp.rivolta.role',
    coKey: 'exp.rivolta.company',
    bullets: ['exp.rivolta.b1', 'exp.rivolta.b2', 'exp.rivolta.b3', 'exp.rivolta.b4', 'exp.rivolta.b5'],
    chips: [...new Set(content.projects.slice(2).flatMap(project => project.tech))],
  },
  {
    big: false,
    icon: expRoleIcons[1],
    labelKey: 'ext.role.build',
    date: 'exp.ai.date',
    roleKey: 'exp.ai.role',
    coKey: 'exp.ai.company',
    bullets: ['exp.ai.b1', 'exp.ai.b2', 'exp.ai.b3'],
    chips: content.projects[0]?.tech ?? [],
  },
  {
    big: false,
    icon: expRoleIcons[2],
    labelKey: 'ext.role.foundation',
    date: 'exp.be.date',
    roleKey: 'exp.be.role',
    coKey: 'exp.be.company',
    bullets: ['exp.be.b1', 'exp.be.b2', 'exp.be.b3'],
    chips: content.stack.find(category => category.key === 'backend')?.primary ?? [],
  },
];

---
<Window id="work" tabKey="exp.kicker" tabEn={en['exp.kicker']} bp="30% 65%">
  <div class="pad">
  <div class="sec-head">
    <h2 class="chrome display" data-i18n="exp.title" set:html={en['exp.title']} />
    <div class="side">
      <div class="status-pill"><span class="dot"></span><span data-i18n="exp.rivolta.company" set:html={en['exp.rivolta.company']} /></div>
      <p data-i18n="exp.desc" set:html={en['exp.desc']} />
    </div>
  </div>
  <div class="roles">
    {
      roles.map((r) => (
        <article class={`glass role${r.big ? ' big' : ''}`} data-reveal>
          <div class="rhead">
            <div class="ic"><Ico name={r.icon} /></div>
            <div class="rlines">
              <div class="rlabel" data-i18n={r.labelKey}>{chrome.en[r.labelKey]}</div>
              <div class="rdate">
                <span data-i18n={r.date} set:html={en[r.date]} />
                {r.dateExtra && (
                  <>
                    {' · '}
                    <span data-i18n={r.dateExtra} set:html={en[r.dateExtra]} />
                  </>
                )}
              </div>
            </div>
          </div>
          <h3 data-i18n={r.roleKey} set:html={en[r.roleKey]} />
          <div class="rco" data-i18n={r.coKey} set:html={en[r.coKey]} />
          <ul>
            {r.bullets.map((k) => (
              <li data-i18n={k} set:html={en[k]} />
            ))}
          </ul>
          <div class="rchips">
            {r.chips.map((c, i) => (
              <span class={`chip${i === 0 ? ' primary' : ''}`}>{c}</span>
            ))}
          </div>
        </article>
      ))
    }
  </div>
  </div>
  <div class="dock-domains dock dock-bl">
    <span class="fillet f-tr fa"></span><span class="fillet f-tr fb"></span>
    <div class="dl" data-i18n="ext.exp.shipped">{chrome.en['ext.exp.shipped']}</div>
    <div class="dom">
      <div class="ic"><Ico name="briefcase" /></div>
      <div><b data-i18n="stats.domains.num" set:html={en['stats.domains.num']} /><span data-i18n="stats.domains.label" set:html={en['stats.domains.label']} /></div>
    </div>
  </div>
  <div class="dock-facts dock dock-br">
    <span class="fillet f-tl fa"></span><span class="fillet f-tl fb"></span>
    <span data-i18n="exp.rivolta.b5" set:html={en['exp.rivolta.b5']} />
  </div>
</Window>
