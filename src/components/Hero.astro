---
// src/components/Hero.astro
---
<header class="py-[120px_0_100px] relative">
  <div class="wrap grid grid-cols-1 md:grid-cols-[1.4fr_1fr] gap-16 items-center">

    <!-- Left: Text content -->
    <div class="fade-up order-2 md:order-none" style="transition-delay: 100ms">
      <div class="inline-flex items-center gap-[10px] font-mono text-[12px] text-accent uppercase tracking-[0.18em] mb-7 min-h-[16px]"
           style="before:content-[''] before:w-6 before:h-px before:bg-accent">
        <span style="display:inline-block;width:24px;height:1px;background:var(--color-accent);flex-shrink:0"></span>
        <span id="eyebrow-text"></span><span class="type-caret" id="eyebrow-caret"></span>
      </div>

      <h1 class="font-serif font-normal text-[clamp(56px,8vw,104px)] leading-[.95] tracking-[-0.02em] m-0 mb-7">
        <span data-i18n="hero.h1.line1">Backend systems,</span><br/>
        <span data-i18n="hero.h1.line2">built to</span>
        <em class="italic text-accent font-normal" data-i18n="hero.h1.em1">scale</em>
        <span data-i18n="hero.h1.line3">&amp;</span><br/>
        <em class="italic text-accent font-normal" data-i18n="hero.h1.em2">last.</em>
      </h1>

      <div class="role-line" aria-live="polite">
        <span class="arrow">$</span>
        <span>currently:</span>
        <span class="role-text" id="role-text"></span>
        <span class="type-caret"></span>
      </div>

      <p class="max-w-[540px] text-ink-dim text-lg leading-[1.55] mb-10"
         data-i18n="hero.sub">
        I'm <strong class="text-ink font-medium">Juaini</strong> — a software engineer with <strong class="text-ink font-medium">3+ years</strong>
        shipping production Java &amp; Node.js services. I design clean architectures,
        harden APIs, and ship microservices that quietly run the business.
      </p>

      <div class="flex gap-3.5 flex-wrap">
        <a
          href="mailto:juaini742@gmail.com"
          class="inline-flex items-center gap-2.5 px-[22px] py-[14px] rounded-full text-sm font-medium tracking-[0.01em] bg-accent text-[#111] hover:bg-accent-soft transition-colors active:translate-y-px"
        >
          <span data-i18n="hero.cta.primary">Start a project</span>
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>

    <!-- Right: Avatar scene (shown first on mobile via order) -->
    <div class="scene fade-up order-first md:order-none" aria-hidden="true" style="transition-delay: 300ms">
      <div class="avatar-wrap">
        <div class="avatar-frame">
          <img src="/juaini-avatar.jpeg" alt="Juaini" />
        </div>
        <span class="avatar-corner tl"></span>
        <span class="avatar-corner tr"></span>
        <span class="avatar-corner bl"></span>
        <span class="avatar-corner br"></span>
        <div class="avatar-info">
          <span class="name">@juaini · Software Engineer</span>
          <span class="live">Online</span>
        </div>
      </div>

      <div class="float-chip c1"><span class="d"></span>Spring Boot</div>
      <div class="float-chip c2"><span class="d"></span>AWS λ</div>
      <div class="float-chip c3"><span class="d"></span>PostgreSQL</div>
      <div class="float-chip c4"><span class="d"></span>Redis</div>
    </div>

  </div>
</header>

<script>
  function typeOnce(el: HTMLElement, text: string, opts: { speed?: number; onDone?: () => void } = {}) {
    const speed = opts.speed ?? 55;
    let i = 0;
    el.textContent = '';
    const tick = () => {
      if (i <= text.length) {
        el.textContent = text.slice(0, i++);
        setTimeout(tick, speed + Math.random() * 30);
      } else if (opts.onDone) opts.onDone();
    };
    tick();
  }

  function typeLoop(el: HTMLElement, words: string[], opts: { typeSpeed?: number; eraseSpeed?: number; hold?: number; between?: number } = {}) {
    const { typeSpeed = 70, eraseSpeed = 35, hold = 1800, between = 400 } = opts;
    let wi = 0;
    const next = () => {
      const word = words[wi % words.length];
      let i = 0;
      const typing = () => {
        if (i <= word.length) {
          el.textContent = word.slice(0, i++);
          setTimeout(typing, typeSpeed + Math.random() * 40);
        } else {
          setTimeout(erase, hold);
        }
      };
      const erase = () => {
        let j = word.length;
        const tick = () => {
          if (j >= 0) {
            el.textContent = word.slice(0, j--);
            setTimeout(tick, eraseSpeed);
          } else {
            wi++;
            setTimeout(next, between);
          }
        };
        tick();
      };
      typing();
    };
    next();
  }

  const eyebrowEl = document.getElementById('eyebrow-text') as HTMLElement;
  const eyebrowCaret = document.getElementById('eyebrow-caret') as HTMLElement;
  const roleEl = document.getElementById('role-text') as HTMLElement;

  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    eyebrowEl.textContent = 'Software Engineer · Available for work';
    eyebrowCaret.style.display = 'none';
    roleEl.textContent = 'Backend Engineer @ PT Rivolta';
  } else {
    typeOnce(eyebrowEl, 'Software Engineer · Available for work', {
      speed: 35,
      onDone: () => {
        setTimeout(() => { eyebrowCaret.style.opacity = '.35'; }, 1200);
      }
    });

    typeLoop(roleEl, [
      'Backend Engineer @ PT Rivolta',
      'Spring Boot specialist',
      'Microservices architect',
      'AWS Lambda · event-driven',
      'React Native · mobile dev',
      'Available for new projects',
    ], { typeSpeed: 60, eraseSpeed: 30, hold: 1600, between: 350 });
  }
</script>
