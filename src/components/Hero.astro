---
// Hero window: eyebrow, chrome headline, sub, CTAs, profile notch,
// stats dock (bottom-left) and status dock (bottom-right).
import type { CmsContent } from '../lib/cms';
import Ico from './Ico.astro';
import Window from './Window.astro';
import { chrome } from '../lib/chrome';

interface Props {
  content: CmsContent;
}
const { content } = Astro.props;
const { settings, translations } = content;
const en = translations.en;

const stats = [
  { numKey: 'stats.years.num', unitKey: 'stats.years.unit', labelKey: 'stats.years.label' },
  { numKey: 'stats.services.num', unitKey: 'stats.services.unit', labelKey: 'stats.services.label' },
  { numKey: 'stats.cert.num', labelKey: 'stats.cert.label' },
];
---
<Window id="top" tabKey="ext.hero.tab" tabEn={chrome.en['ext.hero.tab']} variant="hero" bp="70% 30%">
  <div class="copy">
    <div class="eyebrow"><span class="dot"></span><span data-i18n="hero.eyebrow" set:html={en['hero.eyebrow']} /></div>
    <h1 class="chrome display">
      <span data-i18n="hero.h1.line1" set:html={en['hero.h1.line1']} /><br />
      <span data-i18n="hero.h1.line2" set:html={en['hero.h1.line2']} /> <span data-i18n="hero.h1.em1" set:html={en['hero.h1.em1']} />
    </h1>
    <p class="sub" data-i18n="hero.sub" set:html={en['hero.sub']} />
    <div class="ctas">
      <a class="go" href="#contact"><span data-i18n="hero.cta.primary" set:html={en['hero.cta.primary']} /><span class="arr"><Ico name="arrow-up-right" /></span></a>
      <a class="ln" href="#projects"><span data-i18n="hero.cta.secondary" set:html={en['hero.cta.secondary']} /></a>
    </div>
  </div>
  {content.projects[0] && (
    <div class="termcard glass">
      <div class="tline"><span class="g" data-i18n="ext.hero.term.building">{chrome.en['ext.hero.term.building']}</span> <b data-i18n={`${content.projects[0].i18nPrefix}.title`} set:html={en[`${content.projects[0].i18nPrefix}.title`]} /></div>
      <div class="tline"><span class="g" data-i18n="ext.hero.term.focus">{chrome.en['ext.hero.term.focus']}</span> <b data-i18n="stats.domains.label" set:html={en['stats.domains.label']} /></div>
      <div class="tline"><span class="g" data-i18n="ext.hero.term.stack">{chrome.en['ext.hero.term.stack']}</span> <b>{content.settings.heroChips.join(' · ')}</b></div>
    </div>
  )}
  <div class="profile dock notch-r">
    <span class="fillet f-tl fa"></span><span class="fillet f-bl fb"></span>
    <div class="avatar"><img class="pic" src={settings.avatarUrl} alt={settings.avatarLabel} width="64" height="64" /></div>
    <div>
      <div class="lbl" data-i18n="ext.hero.engineer">Engineer</div>
      <div class="who">{settings.name}</div>
      <div class="rsub" data-i18n="hero.role.1" set:html={en['hero.role.1']} />
    </div>
  </div>
  <div class="stats dock dock-bl">
    <span class="fillet f-tr fa"></span><span class="fillet f-tr fb"></span>
    {
      stats.map((s) => (
        <div class="stat">
          <b class="chrome"><span data-i18n={s.numKey} set:html={en[s.numKey]} />{s.unitKey && <span class={`u${/^[+\-–]/.test(en[s.unitKey]) ? ' tight' : ''}`} data-i18n={s.unitKey} set:html={en[s.unitKey]} />}</b>
          <span data-i18n={s.labelKey} set:html={en[s.labelKey]} />
        </div>
      ))
    }
  </div>
  <div class="status dock dock-br">
    <span class="fillet f-tl fa"></span><span class="fillet f-tl fb"></span>
    <div class="term"><span class="g" data-i18n="ext.hero.currently">$ currently:</span> <b data-i18n="hero.role.1" set:html={en['hero.role.1']} /></div>
    <div class="avail"><span class="dot"></span><span data-i18n="contact.avail.status" set:html={en['contact.avail.status']} /></div>
  </div>
</Window>
