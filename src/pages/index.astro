---
// src/pages/index.astro
// Build-time contract: the CMS endpoint must answer with valid, schema-conform
// content or this build fails. No local/stale fallback exists.
import '../styles/global.css';
import '../styles/navigation.css';
import '../styles/motion.css';
import { fetchCmsContent } from '../lib/cms';
import { buildSprite } from '../lib/sprite';
import { embeddableJson } from '../lib/embed';
import { chrome, chromeIcons } from '../lib/chrome';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Experience from '../components/Experience.astro';
import AppliedAI from '../components/AppliedAI.astro';
import Toolbox from '../components/Toolbox.astro';
import Projects from '../components/Projects.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

const cms = await fetchCmsContent();
const { content } = cms;
const en = content.translations.en;

const techNames = [
  ...new Set([
    ...content.projects.flatMap((p) => p.tech),
    ...content.stack.flatMap((s) => [...s.primary, ...s.items]),
  ]),
];
const { sprite, techIds } = buildSprite([...chromeIcons], techNames);

const dicts = {
  en: { ...chrome.en, ...content.translations.en },
  id: { ...chrome.id, ...content.translations.id },
};
const dictsJson = embeddableJson(dicts);
---
<Layout settings={content.settings} sprite={sprite}>
  <svg width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute">
    <defs>
      <!-- Sasirangan motif (Banjar, Kalimantan Selatan): Gigi Haruan zigzag + Ombak waves + dots. -->
      <pattern id="sasP" width="64" height="56" patternUnits="userSpaceOnUse">
        <path d="M0 10 L8 2 L16 10 L24 2 L32 10 L40 2 L48 10 L56 2 L64 10" fill="none" stroke="#bbc6d1" stroke-width="1.2" />
        <path d="M0 16 L8 8 L16 16 L24 8 L32 16 L40 8 L48 16 L56 8 L64 16" fill="none" stroke="#bbc6d1" stroke-width=".7" opacity=".6" />
        <path d="M0 34 C8 26 16 26 24 34 S40 42 48 34 S64 26 64 34" fill="none" stroke="#bbc6d1" stroke-width="1" />
        <path d="M0 41 C8 33 16 33 24 41 S40 49 48 41 S64 33 64 41" fill="none" stroke="#bbc6d1" stroke-width=".6" opacity=".55" />
        <circle cx="32" cy="50" r="1.6" fill="#bbc6d1" />
        <circle cx="0" cy="50" r="1.6" fill="#bbc6d1" />
        <circle cx="64" cy="50" r="1.6" fill="#bbc6d1" />
      </pattern>
    </defs>
  </svg>
  <a class="skip-link" href="#main-content" data-i18n="ext.nav.skip">{chrome.en['ext.nav.skip']}</a>
  <Nav content={content} />
  <main id="main-content" tabindex="-1">
    <Hero content={content} />
    <Experience content={content} />
    <AppliedAI content={content} />
    <Toolbox content={content} techIds={techIds} />
    <Projects content={content} techIds={techIds} />
    <Contact content={content} />
  </main>
  <Footer content={content} />
  <script type="application/json" id="i18n-dicts" set:html={dictsJson} />
  <script src="../scripts/site.ts"></script>
</Layout>
