---
// src/pages/index.astro
import '../styles/global.css';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import Experience from '../components/Experience.astro';
import AppliedAI from '../components/AppliedAI.astro';
import Stack from '../components/Stack.astro';
import Projects from '../components/Projects.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

import en from '../i18n/en.json';
import id from '../i18n/id.json';

const translations = { en, id };
const translationsJson = JSON.stringify(translations);
---

<Layout>
  <Nav />
  <main>
    <Hero />
    <Stats />
    <Experience />
    <AppliedAI />
    <Stack />
    <Projects />
    <Contact />
  </main>
  <Footer />

  <script define:vars={{ translationsJson }}>
    const translations = JSON.parse(translationsJson);

    function applyLang(lang) {
      const t = translations[lang] ?? translations['en'];
      document.documentElement.setAttribute('lang', lang);
      document.querySelectorAll('[data-i18n]').forEach((el) => {
        const key = el.dataset.i18n;
        if (t[key] !== undefined) el.innerHTML = t[key];
      });
      window.dispatchEvent(new CustomEvent('languagechange', { detail: { lang } }));
    }

    function updateToggleUI(lang) {
      document.querySelectorAll('[data-lang-option]').forEach((opt) => {
        const isActive = opt.dataset.langOption === lang;
        opt.style.opacity = isActive ? '1' : '0.4';
        opt.style.fontWeight = isActive ? '600' : '400';
      });
    }

    const stored = localStorage.getItem('lang') ?? 'en';
    applyLang(stored);
    updateToggleUI(stored);

    document.querySelectorAll('[data-lang-toggle]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const current = localStorage.getItem('lang') ?? 'en';
        const next = current === 'en' ? 'id' : 'en';
        localStorage.setItem('lang', next);
        applyLang(next);
        updateToggleUI(next);
      });
    });
  </script>

  <script>
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '-4% 0px' }
    );

    document.querySelectorAll('.fade-up').forEach((el) => observer.observe(el));

    // sec-head reveal observer
    const headObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('in-view');
            headObserver.unobserve(e.target);
          }
        });
      },
      { threshold: 0.25, rootMargin: '0px 0px -10% 0px' }
    );
    document.querySelectorAll('.sec-head').forEach((el) => headObserver.observe(el));
  </script>

  <script>
    const sections = ['work', 'ai', 'stack', 'projects', 'contact'];
    const navLinks = Object.fromEntries(
      sections.map((id) => [id, document.querySelector(`nav a[href="#${id}"]`)])
    );

    const navObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const link = navLinks[entry.target.id];
          if (!link) return;
          if (entry.isIntersecting) {
            sections.forEach((id) => navLinks[id]?.removeAttribute('data-nav-active'));
            link.setAttribute('data-nav-active', '');
          }
        });
      },
      { threshold: 0.25 }
    );

    sections.forEach((id) => {
      const el = document.getElementById(id);
      if (el) navObserver.observe(el);
    });
  </script>
</Layout>
